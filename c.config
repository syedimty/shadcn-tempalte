apiVersion: v1
kind: Service
metadata:
  name: service1
spec:
  selector:
    app: report-backend
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: v1
kind: Service
metadata:
  name: service2
spec:
  selector:
    app: api-backend
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: report-route
spec:
  host: existing-app.example.com
  path: /api/report
  to:
    kind: Service
    name: service1
  port:
    targetPort: http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: api-route
  annotations:
    haproxy.router.openshift.io/rewrite-target: /
spec:
  host: existing-app.example.com
  path: /api/
  to:
    kind: Service
    name: service2
  port:
    targetPort: http
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
